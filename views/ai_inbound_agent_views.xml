<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Inbound Agent Form View -->
    <record id="view_ai_inbound_agent_form" model="ir.ui.view">
        <field name="name">ai.inbound.agent.form</field>
        <field name="model">ai.inbound.agent</field>
        <field name="arch" type="xml">
            <form string="Inbound AI Agent">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Agent Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="inbound_number" placeholder="e.g. 5162100561"/>
                            <field name="agent_type" widget="radio"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="openai_voice"/>
                            <field name="openai_api_key" password="True"/>
                            <field name="assistant_id"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="General Configuration" invisible="agent_type == 'odoo'">
                            <group>
                                <field name="initial_message"/>
                                <field name="system_prompt" placeholder="You are a helpful assistant..."/>
                            </group>
                        </page>
                        <page string="Odoo Configuration" invisible="agent_type != 'odoo'">
                            <group>
                                <field name="initial_message"/>
                                <field name="odoo_url" placeholder="https://..."/>
                                <field name="odoo_db"/>
                                <field name="odoo_user"/>
                                <field name="odoo_api_key" password="True"/>
                            </group>
                            <label for="allowed_list_ids"/>
                            <field name="allowed_list_ids">
                                <tree editable="bottom">
                                    <field name="phone_number"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- AI Inbound Agent Tree View -->
    <record id="view_ai_inbound_agent_tree" model="ir.ui.view">
        <field name="name">ai.inbound.agent.tree</field>
        <field name="model">ai.inbound.agent</field>
        <field name="arch" type="xml">
            <tree string="Inbound AI Agents">
                <field name="name"/>
                <field name="inbound_number"/>
                <field name="agent_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ai_inbound_agent" model="ir.actions.act_window">
        <field name="name">Inbound AI Agents</field>
        <field name="res_model">ai.inbound.agent</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Inbound AI Agent!
            </p>
        </field>
    </record>

    <!-- Menu Item (Under existing menu or new top level?) -->
    <!-- Assuming "CRM" or existing "AI Call" menu exists. Let's create a new top menu for AI Call if not present, or attach to CRM -->
    <!-- Checking n8n_campaign_views.xml might show where existing menus are -->
    
    <menuitem id="menu_ai_inbound_root" name="AI Inbound" parent="crm.crm_menu_config" sequence="50"/>
    <menuitem id="menu_ai_inbound_agent" name="Inbound Agents" parent="menu_ai_inbound_root" action="action_ai_inbound_agent" sequence="10"/>

</odoo>
